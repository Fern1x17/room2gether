# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
*.iml

# IDE — excluir solo archivos personales, compartir configuración del proyecto
.idea/workspace.xml
.idea/tasks.xml
.idea/.gitignore
.idea/caches/
.idea/deviceManager.xml
.idea/libraries/Dart_Packages.xml
.idea/libraries/Flutter_Plugins.xml
.vscode/*.log
*.swp

# Secretos — NUNCA subir
# Excepción (2026-07-10): .env sí se committea — el build web de CI lo necesita
# como asset. Solo puede contener claves públicas de cliente.
.env.*
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist
**/firebase_options.dart

# Supabase — contiene tu access token; mantenlo local o usa variables de entorno
.mcp.json
supabase/.temp/

# macOS / Windows
.DS_Store
Thumbs.db

# Android
android/.gradle/
android/app/debug
android/app/profile
android/app/release

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
